# 🔐 CONFIGURACIÓN - Copiar a .env y llenar con tus valores

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Opcional: Configuración de directorios
SOURCE_DIR=raw_data
ORGANIZED_DIR=organized_data
REDACTED_DIR=for_claude
OUTPUT_DIR=outputs

# Opcional: Claude model (por defecto: claude-opus-5)
CLAUDE_MODEL=claude-opus-5

# Opcional: Max tokens para respuestas
MAX_TOKENS=1500
